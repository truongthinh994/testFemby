{
  "name": "toeic-master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/domain.test.ts tests/answer-queue.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "local": "node scripts/local.mjs",
    "test:local": "playwright test --config playwright.local.config.ts",
    "local:stop": "node scripts/stop-local.mjs",
    "local:dev": "node scripts/local.mjs --dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
